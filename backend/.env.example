GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# API access token — sent in Authorization: Bearer header by the frontend
# after a successful login. Should be long and random.
ACCESS_TOKEN=your_secret_access_token_here

# Frontend password gate — 6-character alphanumeric code (e.g. aB3xY9)
# Users must enter this to access the site. Validated server-side only.
# Leave blank to disable (dev mode).
FRONTEND_PASSWORD=aB3xY9

DATABASE_URL=postgresql://user:password@host/dbname
